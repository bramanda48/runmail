{
  "name": "runmail",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "portless",
    "build": "bun run -F @runmail/web build",
    "db:migrate": "bun run -F @runmail/worker migrate",
    "db:generate": "bun run -F @runmail/db generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run -F '*' typecheck",
    "test": "bun test",
    "wrangler": "bun run -F @runmail/worker wrangler",
    "wrangler:types": "bun run -F @runmail/worker types"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "lint-staged": "^17.6.2",
    "portless": "^0.15.13",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bun x lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,js,cjs,mjs,mts}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "**/*.{json,jsonc,yaml}": [
      "prettier --write"
    ]
  }
}
