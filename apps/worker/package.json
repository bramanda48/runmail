{
  "name": "@runmail/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler types && wrangler deploy --dry-run",
    "migrate": "wrangler d1 migrations apply DB",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface CloudflareBindings",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@runmail/db": "workspace:*",
    "@runmail/shared": "workspace:*",
    "bcrypt-ts": "^9.0.2",
    "cloudflare": "^7.3.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "postal-mime": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
