{
  "name": "runmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_ENV": "development",
    "CLOUDFLARE_ACCOUNT_ID": "placeholder-account-id",
    "JWT_ACCESS_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "TRASH_SPAM_RETENTION_DAYS": "30",
    "SYNC_RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runmail-dev",
      "database_id": "PLACEHOLDER-LOCAL-DEV",
      "migrations_dir": "../../packages/db/src/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "RAW_EMAIL_BUCKET", "bucket_name": "runmail-raw-dev" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
