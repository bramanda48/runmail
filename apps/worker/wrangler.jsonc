{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runmail",
  "main": "src/serve.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "dev": {
    "port": 3001,
  },
  "cache": {
    "enabled": true,
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runmail",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "runmail-storage",
    },
  ],
  "triggers": { "crons": ["0 3 * * *"] },
}
